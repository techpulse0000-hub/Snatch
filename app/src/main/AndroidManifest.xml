<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Only needed for Android 9 and below; Android 10+ uses scoped storage / MediaStore -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Snatch"
        android:extractNativeLibs="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Theme.Snatch">

        <!-- Home screen — the actual downloads list -->
        <activity
            android:name=".DownloadsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Settings screen — reached via the toolbar gear icon, not the launcher -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- Embedded video player — opened from the Play button on a finished download -->
        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:theme="@style/Theme.Snatch"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Invisible activity: this is what shows up in the Android Share Sheet.
             It has no UI, grabs the URL, hands it to the service, and closes itself.
             This is also the DEFAULT entry — uses whatever quality is set in Settings. -->
        <activity
            android:name=".ShareReceiverActivity"
            android:exported="true"
            android:label="Snatch"
            android:theme="@style/Theme.Transparent"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Same activity, three more entries in the share sheet — one per fixed quality -->
        <activity-alias
            android:name=".Share480Activity"
            android:targetActivity=".ShareReceiverActivity"
            android:exported="true"
            android:label="Snatch 480p"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Share720Activity"
            android:targetActivity=".ShareReceiverActivity"
            android:exported="true"
            android:label="Snatch 720p"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Share1080Activity"
            android:targetActivity=".ShareReceiverActivity"
            android:exported="true"
            android:label="Snatch 1080p"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ShareAudioActivity"
            android:targetActivity=".ShareReceiverActivity"
            android:exported="true"
            android:label="Snatch Audio"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".SharePhotoActivity"
            android:targetActivity=".ShareReceiverActivity"
            android:exported="true"
            android:label="Snatch Photo"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>
